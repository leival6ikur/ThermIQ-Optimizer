# ThermIQ Heat Pump Optimizer Configuration

# MQTT Broker Settings
mqtt:
  broker: localhost
  port: 1883
  device_id: thermiq_room2lp
  username: null  # Add authentication post-MVP
  password: null
  reconnect_delay: 5
  keepalive: 60

# Nord Pool Electricity Pricing
nordpool:
  region: EE  # Estonia (Tartu region)
  currency: EUR
  api_url: https://www.nordpoolgroup.com/api/marketdata/page/10
  fetch_time: "13:00"  # UTC time when prices are published
  cache_hours: 48
  retry_attempts: 3

# Installation Location
# Configure your heat pump's location here, or use environment variables:
# THERMIQ_ADDRESS, THERMIQ_LATITUDE, THERMIQ_LONGITUDE, THERMIQ_TIMEZONE
location:
  address: "Your Address Here"  # Display name for your installation
  latitude: 0.0  # Your location's latitude (required for weather data)
  longitude: 0.0  # Your location's longitude
  timezone: "UTC"  # IANA timezone (e.g., "Europe/Tallinn", "America/New_York")

# Weather Forecast Integration (Optional)
# Enables weather-based optimization and heating load prediction
weather:
  enabled: false  # Set to true to enable weather integration
  api_key: ""  # OpenWeather API key (get free at https://openweathermap.org/api)
  # Weather data uses location.latitude and location.longitude configured above
  # Free tier: 1000 calls/day, updates every hour

# NetAtmo Weather Station Integration (Optional)
# Use NetAtmo weather station as alternative temperature data source
netatmo:
  enabled: false  # Set to true to enable NetAtmo integration
  client_id: ""  # NetAtmo app client ID (create app at https://dev.netatmo.com/)
  client_secret: ""  # NetAtmo app client secret
  username: ""  # NetAtmo account email
  password: ""  # NetAtmo account password
  station_name: ""  # Optional - uses first station if empty
  outdoor_module_name: ""  # Optional - auto-detects outdoor module
  polling_interval: 600  # Poll NetAtmo API every 10 minutes (600 seconds)

# Temperature Data Sources
# Choose which sensors to use for temperature readings
temperature_sources:
  outdoor_source: "heat_pump"  # "heat_pump" or "netatmo"
  indoor_source: "heat_pump"   # "heat_pump" or "netatmo"
  # Heat pump provides all specialized sensors (supply, return, brine, hot water)
  # NetAtmo provides more accurate ambient outdoor temperature

# Optimization Settings
optimization:
  strategy: balanced  # aggressive | balanced | conservative
  target_temperature: 21.0
  temperature_tolerance: 1.0  # Allow ±1°C variation
  comfort_hours_start: "06:00"
  comfort_hours_end: "23:00"
  update_interval: 300  # Recalculate schedule every 5 minutes

# Building Thermal Characteristics
building:
  insulation_quality: good  # poor | average | good | excellent
  thermal_mass: medium  # low | medium | high
  estimated_heat_loss_per_degree: 0.5  # °C per hour at 10°C outdoor
  heating_rate: 2.0  # °C per hour when heating

# API Server Settings
api:
  host: 0.0.0.0
  port: 8000
  cors_origins:
    - http://localhost:3000
    - http://localhost:5173

# Database Settings
database:
  path: ./data/thermiq.db
  backup_enabled: true
  backup_interval_hours: 24

# Logging Configuration
logging:
  level: INFO  # DEBUG | INFO | WARNING | ERROR
  file: ./data/logs/thermiq.log
  rotation: daily
  retention_days: 30
